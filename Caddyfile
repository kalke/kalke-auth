{
	admin off
}

# Public OIDC façade. Host port is bound to 127.0.0.1 by Compose
# (see PUBLIC_BIND) — that is the admin/network encapsulation for local use.
:8443 {
	reverse_proxy keycloak:8080 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Port {server_port}
	}
}
