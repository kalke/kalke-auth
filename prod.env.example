# Copy to prod.env (gitignored) and fill values.
# source with: set -a; source prod.env; set +a

# Both must be the Tunnel URL so admin console OIDC stays behind Access.
KC_HOSTNAME='https://keycloak.kalke.dev'
KC_HOSTNAME_ADMIN='https://keycloak.kalke.dev'
# JWT / discovery issuer for realm kalke (set by entrypoint on kalke realm).
KC_REALM_FRONTEND_URL='https://auth.kalke.dev'
KC_DB='postgres'
# Keycloak: use Neon DIRECT host (no -pooler) with currentSchema=
KC_DB_URL='jdbc:postgresql://HOST/neondb?sslmode=require&currentSchema=keycloak'
KC_DB_USERNAME='neondb_owner'
KC_DB_PASSWORD=''
KC_BOOTSTRAP_ADMIN_USERNAME=''
KC_BOOTSTRAP_ADMIN_PASSWORD=''
# Apps: pooler host, sslmode only — schema via DB_SEARCH_PATH
DATABASE_URL='postgresql://neondb_owner:PASSWORD@HOST-pooler/neondb?sslmode=require'
DB_SEARCH_PATH='app'
REDIS_ADDR='YOUR.upstash.io:6379'
REDIS_PASSWORD=''
REDIS_TLS='true'
SESSION_SECRET=''
TOKEN_HASH_PEPPER=''
INTROSPECT_SECRET=''
KC_BFF_CLIENT_ID='kalke-bff'
KC_BFF_CLIENT_SECRET=''
SIGNUP_ENABLED='true'
ADMIN_EMAILS='henriquekalke@icloud.com'
MAIL_FROM='kalke <noreply@noreply.kalke.dev>'
# Prefer Mailgun; Resend works as fallback. Local: MAIL_DEV_LOG=true
MAILGUN_API_KEY=''
MAILGUN_DOMAIN='noreply.kalke.dev'
RESEND_API_KEY=''
MAIL_DEV_LOG='false'
KC_INTERNAL_URL='http://127.0.0.1:8081'
KC_PUBLIC_ISSUER='https://auth.kalke.dev/realms/kalke'
CORS_ORIGINS='https://kalke.dev,https://www.kalke.dev,http://localhost:5173'
COOKIE_DOMAIN='.kalke.dev'
HTTP_ADDR=':8080'
# Browser extract uses cookie session; BFF proxies to PDE with M2M (never expose PAT to SPA).
PDE_BASE_URL='https://pde.kalke.dev'
PDE_M2M_CLIENT_ID='pde-m2m'
PDE_M2M_CLIENT_SECRET=''
# AWS Free Tier EC2: use docker-compose.aws.yml (Caddy terminates TLS for auth.kalke.dev).
# Cloudflare Tunnel token (Zero Trust → Networks → Tunnels). Enables keycloak.kalke.dev admin UI.
CLOUDFLARE_TUNNEL_TOKEN=''
