# Local Auth BFF (Go API). Used by docker-compose.yml — never for auth.kalke.dev.
# Copy: cp local.env.example local.env

DATABASE_URL=postgres://kalke:kalke@app-db:5432/kalke?sslmode=disable
DB_SEARCH_PATH=app
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_TLS=false

SESSION_SECRET=local-dev-session-secret-do-not-use-in-prod
TOKEN_HASH_PEPPER=local-dev-token-pepper-do-not-use-in-prod
INTROSPECT_SECRET=local-dev-introspect-secret

KC_BFF_CLIENT_ID=kalke-bff
KC_BFF_CLIENT_SECRET=kalke-bff-dev-secret
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin
KC_INTERNAL_URL=http://keycloak:8080
KC_PUBLIC_ISSUER=http://localhost:8443/realms/kalke

HTTP_ADDR=:8080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

SIGNUP_ENABLED=true
MAIL_DEV_LOG=true
MAIL_FROM=kalke <noreply@localhost>
ADMIN_EMAILS=demo@kalke.local

OAUTH_REDIRECT_URI=http://localhost:8090/v1/auth/callback
OAUTH_SUCCESS_URL=http://localhost:5173/playground

# Playground extract proxy (browser → BFF cookie → PDE with M2M JWT).
PDE_BASE_URL=http://api:8080
PDE_M2M_CLIENT_ID=pde-m2m
PDE_M2M_CLIENT_SECRET=pde-m2m-dev-secret
PDE_USER_FORWARD_SECRET=local-dev-m2m-forward-secret
