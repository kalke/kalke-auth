# Keycloak DB (namespaced — do not reuse POSTGRES_* from other projects)
KC_DB_USER=keycloak
KC_DB_PASSWORD=keycloak
KC_DB_NAME=keycloak

# Keycloak bootstrap admin (first boot). Change in any shared environment.
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=admin

# Public issuer base URL (must match OIDC_ISSUER host/port in consumer apps).
# Tokens will use: {KC_HOSTNAME}/realms/kalke
KC_HOSTNAME=http://localhost:8443

# Caddy listen (bound to loopback by default)
PUBLIC_BIND=127.0.0.1
PUBLIC_PORT=8443

# Demo user (imported via realm; change after first login in real use)
# Username / email: demo@kalke.local
# Password:       DemoPass123!
